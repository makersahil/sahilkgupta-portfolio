generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Domain {
  NETWORKING
  LINUX
  DEVOPS
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum InquiryStatus {
  NEW
  READ
  RESPONDED
  ARCHIVED
}

enum LabKind {
  NETWORK_TOPOLOGY
  LINUX_SYSTEM
  DEVOPS_PIPELINE
}

enum LabStatus {
  DRAFT
  READY
  ARCHIVED
}

enum EvidenceKind {
  CONFIGURATION
  COMMAND_OUTPUT
  TOPOLOGY
  RUNBOOK
  SCREENSHOT
  ARTIFACT
  LINK
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String?
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  blogPosts         BlogPost[]    @relation("BlogAuthor")
  uploadedArtifacts Artifact[]    @relation("ArtifactUploader")
  auditLogs         AuditLog[]    @relation("AuditLogActor")
  updatedSettings   SiteSetting[] @relation("SiteSettingUpdater")
}

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  domain      Domain?
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  projects       Project[]
  certifications Certification[]
  skills         Skill[]
}

model Project {
  id                  String        @id @default(cuid())
  slug                String        @unique
  title               String
  domain              Domain
  summary             String
  mission             String?
  architectureSummary String?
  whatIBuilt          String?
  status              ContentStatus @default(PUBLISHED)
  featured            Boolean       @default(false)
  technologies        String[]
  tags                String[]
  categoryId          String?
  category            Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  runbookSteps ProjectRunbookStep[]
  evidence     Evidence[]
  lab          Lab?                 @relation("ProjectLab")
  artifacts    Artifact[]           @relation("ProjectArtifact")

  @@index([domain])
  @@index([status])
  @@index([featured])
  @@index([publishedAt])
}

model ProjectRunbookStep {
  id          String   @id @default(cuid())
  projectId   String
  order       Int
  title       String
  description String?
  command     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  content     String        @db.Text
  domain      Domain?
  status      ContentStatus @default(PUBLISHED)
  tags        String[]
  authorId    String?
  author      User?         @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([domain])
  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  source    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model LearningTrack {
  id                  String        @id @default(cuid())
  slug                String        @unique
  title               String
  domain              Domain
  description         String?
  completedObjectives Int           @default(0)
  totalObjectives     Int           @default(0)
  status              ContentStatus @default(PUBLISHED)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Lab {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  summary       String?
  domain        Domain
  kind          LabKind
  status        LabStatus @default(READY)
  projectId     String?   @unique
  isInteractive Boolean   @default(true)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project   Project?      @relation("ProjectLab", fields: [projectId], references: [id], onDelete: Cascade)
  nodes     LabNode[]
  links     LabLink[]
  scenarios LabScenario[]
  evidence  Evidence[]
  artifacts Artifact[]    @relation("LabArtifact")

  @@index([domain])
  @@index([kind])
  @@index([status])
}

model LabNode {
  id            String   @id @default(cuid())
  labId         String
  nodeKey       String
  label         String
  kind          String
  description   String?
  position      Json?
  configuration Json?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([labId, nodeKey])
}

model LabLink {
  id            String   @id @default(cuid())
  labId         String
  linkKey       String
  sourceNodeKey String
  targetNodeKey String
  label         String?
  kind          String?
  configuration Json?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([labId, linkKey])
}

model LabScenario {
  id                   String   @id @default(cuid())
  labId                String
  slug                 String   @unique
  title                String
  summary              String
  description          String?
  order                Int      @default(0)
  isEnabled            Boolean  @default(true)
  baselineState        Json?
  actions              Json?
  expectedObservations Json?
  verificationCriteria Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)
}

model Evidence {
  id          String       @id @default(cuid())
  projectId   String?
  labId       String?
  kind        EvidenceKind
  title       String
  description String?
  content     Json?
  artifactId  String?
  artifact    Artifact?    @relation("EvidenceArtifact", fields: [artifactId], references: [id], onDelete: SetNull)
  externalUrl String?
  isPublic    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lab     Lab?     @relation(fields: [labId], references: [id], onDelete: Cascade)
}

model Artifact {
  id              String     @id @default(cuid())
  fileName        String
  originalName    String?
  mimeType        String
  storageProvider String // LOCAL, S3, EXTERNAL
  storageKey      String
  sizeBytes       Int
  sha256          String?
  publicUrl       String?
  projectId       String?
  project         Project?   @relation("ProjectArtifact", fields: [projectId], references: [id], onDelete: SetNull)
  labId           String?
  lab             Lab?       @relation("LabArtifact", fields: [labId], references: [id], onDelete: SetNull)
  uploadedById    String?
  uploadedBy      User?      @relation("ArtifactUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  evidence        Evidence[] @relation("EvidenceArtifact")
  isPublic        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([projectId])
  @@index([labId])
  @@index([uploadedById])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorUser   User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([entityType])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  isPublic    Boolean  @default(true)
  updatedById String?
  updatedBy   User?    @relation("SiteSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certification {
  id                String    @id @default(cuid())
  title             String
  code              String
  issuer            String
  credentialId      String
  verificationUrl   String?
  badgeIcon         String
  issueDate         DateTime
  expiryDate        DateTime?
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  skillsValidated   String[]
  syllabusBreakdown Json?
  isFeatured        Boolean   @default(false)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Skill {
  id                 String    @id @default(cuid())
  name               String
  level              String
  proficiencyPercent Int
  yearsOfExperience  Int
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  iconName           String?
  terminalSnippet    String?
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL / Prisma
# PostgreSQL is the only supported runtime persistence provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Authentication
# Use at least 32 random characters for JWT_SECRET.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Explicit administrator bootstrap only. Normal prisma seed does NOT create users.
# After `npm run auth:bootstrap-admin` succeeds, ADMIN_PASSWORD is not needed by runtime login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
ADMIN_DISPLAY_NAME=Sahil K Gupta

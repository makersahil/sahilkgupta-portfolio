# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
REQUIRE_HTTPS=false
SECURITY_ENFORCEMENT=false
CSRF_ENFORCEMENT=false

# PostgreSQL / Prisma
# Runtime should normally use the pooled endpoint. Prisma CLI should use the direct endpoint.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=verify-full

# Authentication
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
# Required as an independent secret in production; development may fall back to JWT_SECRET.
CSRF_SECRET=replace-with-another-random-secret-at-least-32-characters
RATE_LIMIT_ENABLED=false
# Required as a separate HMAC key in production; development may fall back to JWT_SECRET.
RATE_LIMIT_HASH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters

# Explicit administrator bootstrap only. Normal Prisma seed does not create users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
ADMIN_DISPLAY_NAME=Sahil K Gupta

# Request and server limits
REQUEST_BODY_LIMIT_BYTES=2097152
SHUTDOWN_TIMEOUT_MS=15000
READINESS_TIMEOUT_MS=5000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# Managed artifact bytes
# In production use an absolute private path outside the repository web root and dist directory.
ARTIFACT_STORAGE_ENABLED=true
ARTIFACT_STORAGE_DIR=.runtime/artifacts
ARTIFACT_MAX_BYTES=10485760
ARTIFACT_VERIFY_ON_READ=false

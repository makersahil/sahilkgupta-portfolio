{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:check": "tsx server/scripts/db-check.ts",
    "test:content:static": "tsx server/scripts/content-persistence-static-audit.ts",
    "test:api-client": "tsx server/scripts/api-client-regression.ts",
    "test:content:http": "tsx server/scripts/content-http-regression.ts",
    "test:content:prisma": "tsx server/scripts/content-prisma-regression.ts",
    "test:content:restart": "tsx server/scripts/content-restart-persistence.ts",
    "test:content:smoke": "tsx server/scripts/content-persistence-smoke.ts",
    "auth:bootstrap-admin": "tsx server/scripts/bootstrap-admin.ts",
    "test:auth:static": "tsx server/scripts/auth-static-audit.ts",
    "test:auth": "tsx server/scripts/auth-regression.ts",
    "auth:cleanup-sessions": "tsx server/scripts/cleanup-auth-sessions.ts",
    "test:labs:static": "tsx server/scripts/lab-platform-static-audit.ts",
    "test:labs": "tsx server/scripts/lab-platform-regression.ts",
    "test:labs:manifest": "tsx server/scripts/lab-manifest-regression.ts",
    "test:labs:http": "tsx server/scripts/lab-platform-http-regression.ts",
    "test:networking:static": "tsx server/scripts/networking-engine-static-audit.ts",
    "test:networking": "tsx server/scripts/networking-engine-regression.ts",
    "test:networking:http": "tsx server/scripts/networking-engine-http-regression.ts",
    "test:networking:operations": "tsx server/scripts/networking-operations-regression.ts",
    "test:networking:operations:http": "tsx server/scripts/networking-operations-http-regression.ts",
    "test:admin:static": "tsx server/scripts/admin-static-audit.ts",
    "test:admin:http": "tsx server/scripts/admin-http-regression.ts",
    "verify": "tsx server/scripts/verify.ts full",
    "verify:tests": "tsx server/scripts/verify.ts tests",
    "verify:quick": "tsx server/scripts/verify.ts quick",
    "test:runtime:static": "tsx server/scripts/runtime-persistence-static-audit.ts",
    "test:runtime:http": "tsx server/scripts/runtime-persistence-http-regression.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
